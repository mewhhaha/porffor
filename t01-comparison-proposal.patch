+name: Snapshot comparison contracts
+
+on:
+  pull_request:
+  push:
+    branches:
+      - main
+
+permissions:
+  contents: read
+
+jobs:
+  snapshot-comparison:
+    runs-on: ubuntu-latest
+    timeout-minutes: 30
+    env:
+      CARGO_BUILD_JOBS: 2
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          persist-credentials: false
+      - name: Record inputs and build the comparison contract target
+        shell: bash
+        run: |
+          set -euo pipefail
+          mkdir -p /tmp/snapshot-comparison-evidence
+          git rev-parse HEAD | tee /tmp/snapshot-comparison-evidence/source-commit.txt
+          sha256sum crates/lila-test262/src/lib.rs crates/lila-test262/tests/snapshot_comparison_identity.rs \
+            | tee /tmp/snapshot-comparison-evidence/input-sha256.txt
+          cargo test --locked -p lila-test262 --test snapshot_comparison_identity --no-run --message-format=json \
+            > /tmp/snapshot-comparison-evidence/build.jsonl
+      - name: Execute the complete compiled inventory
+        shell: bash
+        run: |
+          python3 - <<'PY'
+          import json
+          import sys
+          from pathlib import Path
+          sys.path.insert(0, "scripts")
+          from run_engine_regression_inventory import run_inventory
+          evidence = Path("/tmp/snapshot-comparison-evidence")
+          binaries = set()
+          for line in (evidence / "build.jsonl").read_text().splitlines():
+              message = json.loads(line)
+              if (message.get("reason") == "compiler-artifact"
+                      and message["target"]["name"] == "snapshot_comparison_identity"
+                      and message["profile"]["test"] and message.get("executable")):
+                  binaries.add(message["executable"])
+          if len(binaries) != 1:
+              raise SystemExit(f"expected exactly one comparison test executable, found {binaries}")
+          summary = run_inventory(Path(binaries.pop()), evidence, timeout=120)
+          if summary["passed"] != summary["total"]:
+              raise SystemExit("comparison contract inventory failed")
+          PY
+      - name: Retain snapshot evidence and execution identity contracts
+        run: >-
+          cargo test --locked -p lila-test262
+          --test snapshot_use_structure
+          --test aggregate_evidence_requirement_structure
+          --test execution_identity_structure
+      - uses: actions/upload-artifact@v4
+        if: always()
+        with:
+          name: snapshot-comparison-contracts
+          path: /tmp/snapshot-comparison-evidence
+          if-no-files-found: error
