#!/usr/bin/env python3
"""Bound verification scratch without changing compiler or query semantics."""
import os
from pathlib import Path
import runpy
import sys


def compiler_command(arguments, omit_normal_incremental=False, retain_intl_incremental=False):
    """Keep queries literal; omit scratch only for selected compiler units."""
    if not arguments:
        raise ValueError("expected the real rustc executable")
    if "--test" not in arguments[1:]:
        if not omit_normal_incremental or "--crate-name" not in arguments[1:]:
            return list(arguments)
        crate_index = arguments.index("--crate-name") + 1
        if (retain_intl_incremental and crate_index < len(arguments)
                and arguments[crate_index] == "scriptw_intl"):
            return list(arguments)
    command = [arguments[0]]
    index = 1
    while index < len(arguments):
        word = arguments[index]
        if (word == "-C" and index + 1 < len(arguments)
                and arguments[index + 1].startswith("incremental=")):
            index += 2
            continue
        if word.startswith("-Cincremental="):
            index += 1
            continue
        command.append(word)
        index += 1
    return command


def command_from_environment(arguments, environment):
    """Retain Intl scratch only when explicitly requested; libtests still omit it."""
    retained = environment.get("SCRIPTW_TEST_KEEP_INTL_INCREMENTAL")
    if retained not in (None, "1"):
        raise ValueError("SCRIPTW_TEST_KEEP_INTL_INCREMENTAL must be 1")
    return compiler_command(arguments,
                            omit_normal_incremental=environment.get("SCRIPTW_TEST_NO_INCREMENTAL") == "1",
                            retain_intl_incremental=retained == "1")


def codegen_capacity():
    """Use only the finite cloud budget and inherited quota-bound CPU set."""
    sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
    from limited_verification import require_cloud_budget, cloud_worker_affinity
    require_cloud_budget(serial=False)
    return cloud_worker_affinity()


def compiler_environment(arguments, environment):
    """Give one serial Cargo unit a bounded private LLVM jobserver."""
    result = dict(environment)
    requested = result.get("SCRIPTW_TEST_CODEGEN_JOBS")
    if requested is None:
        return result, ()
    if requested != "auto":
        raise ValueError("SCRIPTW_TEST_CODEGEN_JOBS must be auto")
    # Cargo also invokes rustc for target/filename queries. Preserve those.
    if "--crate-name" not in arguments or any(
            word == "--print" or word.startswith("--print=") for word in arguments):
        return result, ()
    if result.get("CARGO_BUILD_JOBS") != "1":
        raise ValueError("parallel codegen requires serial Cargo (CARGO_BUILD_JOBS=1)")
    jobs = codegen_capacity()
    if jobs < 1:
        raise ValueError("parallel codegen requires a positive CPU capacity")
    if jobs == 1:
        return result, ()
    reader, writer = os.pipe()
    try:
        for descriptor in (reader, writer):
            os.set_inheritable(descriptor, True)
        # Rustc owns one implicit slot. Each additional task needs a token.
        if os.write(writer, b"+" * (jobs - 1)) != jobs - 1:
            raise OSError("could not initialize all codegen jobserver tokens")
        result["CARGO_MAKEFLAGS"] = (
            f"-j --jobserver-fds={reader},{writer} --jobserver-auth={reader},{writer}")
        result.pop("MAKEFLAGS", None)
        result.pop("MFLAGS", None)
        return result, (reader, writer)
    except BaseException:
        os.close(reader)
        os.close(writer)
        raise


def protect_preserved_outputs(arguments, environment):
    """Optional owned-output protection composes with existing test policy."""
    if (environment.get("SCRIPTW_PRESERVED_OUTPUT_INVENTORY")
            or environment.get("SCRIPTW_OUTPUT_PROTECTION_LOG")):
        helper = runpy.run_path(str(Path(__file__).with_name("preserve-output-rustc")))
        helper["protect_from_environment"](arguments, environment)


if __name__ == "__main__":
    descriptors = ()
    try:
        command = command_from_environment(sys.argv[1:], os.environ)
        environment, descriptors = compiler_environment(command, os.environ)
        protect_preserved_outputs(command[1:], os.environ)
        os.execve(command[0], command, environment)
    except (OSError, ValueError) as error:
        print(f"test-rustc: {error}", file=sys.stderr)
        raise SystemExit(2)
    finally:
        for descriptor in descriptors:
            os.close(descriptor)
