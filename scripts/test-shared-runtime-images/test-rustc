#!/usr/bin/env python3
"""Avoid disposable libtest incremental scratch; retain normal library caches."""
import os
import sys


def compiler_command(arguments):
    """Preserve compiler arguments except incremental storage for --test units."""
    if not arguments:
        raise ValueError("expected the real rustc executable")
    if "--test" not in arguments[1:]:
        return list(arguments)
    command = [arguments[0]]
    index = 1
    while index < len(arguments):
        word = arguments[index]
        if (word == "-C" and index + 1 < len(arguments)
                and arguments[index + 1].startswith("incremental=")):
            index += 2
            continue
        if word.startswith("-Cincremental="):
            index += 1
            continue
        command.append(word)
        index += 1
    return command


if __name__ == "__main__":
    command = compiler_command(sys.argv[1:])
    os.execv(command[0], command)
