+    )
+    .unwrap();
+    assert!(ForeignModuleRegistry::new(vec![a, b]).is_err());
+    for namespace in ["scriptw_runtime", "scriptw_host", "scriptw_foreign"] {
+        assert!(ForeignFunctionDeclaration::new(
+            "x",
+            namespace,
+            "x",
+            vec![],
+            ForeignResultType::Void
+        )
+        .is_err());
+    }
